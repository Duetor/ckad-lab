#!/usr/bin/env bash
# ckad — small CKAD exercise manager for minikube
set -euo pipefail

LAB_DIR="${CKAD_LAB_DIR:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
EX_DIR="$LAB_DIR/exercises"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ckad"
export CKAD_LAB_DIR="$LAB_DIR"
export MSYS_NO_PATHCONV=1   # Git Bash: do not rewrite /xxx arguments into Windows paths
export CKAD_ANSWERS_DIR="${CKAD_ANSWERS_DIR:-$HOME/ckad-answers}"
mkdir -p "$STATE_DIR" "$CKAD_ANSWERS_DIR"

if [ -t 1 ]; then G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; B=$'\e[1m'; D=$'\e[2m'; N=$'\e[0m'; else G=; R=; Y=; B=; D=; N=; fi

die() { echo "${R}Error:${N} $*" >&2; exit 1; }

usage() {
  cat <<USAGE
${B}ckad${N} — CKAD practice on minikube

${B}Typical workflow${N}
  ckad list                 1. Pick an exercise
  ckad start 01             2. Set it up (fresh namespace ckad-01) and read the task
                            3. Solve it with kubectl, as in the real exam
  ckad check 01             4. Get graded: one line per criterion, ✔ or ✘
  ckad hint 01              5. Stuck? Read the hints, fix, run check again
  ckad solution 01          6. Still stuck? Read the commented solution

${B}All commands${N}
  ckad list                 List exercises and your progress
  ckad start <id>           Reset + set up the exercise, then print the task
  ckad show <id>            Print the task again
  ckad hint <id>            Print the hints
  ckad check <id|all>       Grade your work (all = global score)
  ckad solution <id>        Print the commented solution
  ckad reset <id|all>       Delete the namespace and your answer files
  ckad exam [minutes]       Exam mode: set up every exercise + start a timer (default 120 min)
  ckad status               Time left in exam mode

Answer files go to ${CKAD_ANSWERS_DIR}
USAGE
}

require_cluster() {
  kubectl get --raw /readyz >/dev/null 2>&1 || die "cluster unreachable. Run: minikube start -p ckad"
}

all_ids() { find "$EX_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort | cut -c1-2; }

resolve() {
  [[ "${1:-}" =~ ^[0-9]+$ ]] || die "invalid exercise id: '${1:-}' (e.g. 01). See: ckad list"
  local id d
  id=$(printf '%02d' "$((10#$1))")
  d=$(find "$EX_DIR" -mindepth 1 -maxdepth 1 -type d -name "${id}-*" | head -1)
  [ -n "$d" ] || die "exercise $id not found (ckad list)"
  echo "$d"
}

title()  { head -1 "$1/README.md" | sed 's/^# *//'; }
domain() { grep -m1 '^\*\*Domain' "$1/README.md" | sed 's/^.*:\*\* *//'; }

show() {
  local id; id=$(basename "$1" | cut -c1-2)
  echo
  sed -n '/^## Hints/q;p' "$1/README.md"
  echo "${D}When done: ckad check $id   ·   Stuck: ckad hint $id   ·   Start over: ckad start $id${N}"
}

# pad <width> <text>: pads by characters (not bytes)
pad() { local s="$2"; printf '%s%*s' "$s" $(( $1 - ${#s} > 0 ? $1 - ${#s} : 0 )) ''; }

cmd_list() {
  printf '%s%-4s %s %s %s%s\n' "$B" "ID" "$(pad 44 Exercise)" "$(pad 40 Domain)" "Status" "$N"
  local id d st
  for id in $(all_ids); do
    d=$(resolve "$id")
    if [ -f "$STATE_DIR/$id.ok" ]; then st="${G}✔ passed${N}"
    elif [ -f "$STATE_DIR/$id.started" ]; then st="${Y}… in progress${N}"
    else st="${D}-${N}"; fi
    printf '%-4s %s %s %s\n' "$id" "$(pad 44 "$(title "$d" | sed 's/^[0-9]* *— *//')")" "$(pad 40 "$(domain "$d" | sed 's/^Application //')")" "$st"
  done
}

do_reset() {
  local id; id=$(basename "$1" | cut -c1-2)
  kubectl delete namespace "ckad-$id" --ignore-not-found --wait=true >/dev/null
  rm -rf "$CKAD_ANSWERS_DIR/$id"-* "$STATE_DIR/$id.ok" "$STATE_DIR/$id.started"
}

do_setup() {
  local id; id=$(basename "$1" | cut -c1-2)
  do_reset "$1"
  bash "$1/setup.sh"
  touch "$STATE_DIR/$id.started"
}

do_check() {
  local d="$1" id out rc
  id=$(basename "$d" | cut -c1-2)
  echo "${B}== $(title "$d")${N}"
  set +e
  out=$(bash "$d/check.sh")
  rc=$?
  set -e
  echo "$out" | grep -v '^SCORE '
  if [ "$rc" -eq 0 ]; then touch "$STATE_DIR/$id.ok"; else rm -f "$STATE_DIR/$id.ok"; fi
  LAST_SCORE=$(echo "$out" | sed -n 's/^SCORE //p')
  return "$rc"
}

cmd_check() {
  require_cluster
  if [ "${1:-}" = "all" ]; then
    local p=0 t=0 id s
    for id in $(all_ids); do
      do_check "$(resolve "$id")" || true
      s=${LAST_SCORE:-0/0}; p=$((p + ${s%/*})); t=$((t + ${s#*/})); echo
    done
    echo "${B}Global score: $p/$t ($(( t > 0 ? p * 100 / t : 0 ))%)${N} — the real exam pass mark is 66%."
  else
    do_check "$(resolve "${1:-}")"
  fi
}

cmd_exam() {
  require_cluster
  local minutes="${1:-120}" id
  echo "${B}Exam mode: setting up every exercise...${N}"
  for id in $(all_ids); do
    printf '  %s %s\n' "$id" "$(title "$(resolve "$id")" | sed 's/^[0-9]* *— *//')"
    do_setup "$(resolve "$id")" >/dev/null
  done
  echo $(( $(date +%s) + minutes * 60 )) > "$STATE_DIR/exam_end"
  echo
  echo "${G}Go: ${minutes} minutes.${N} Tasks: ckad show <id> — time left: ckad status — finish: ckad check all"
}

cmd_status() {
  [ -f "$STATE_DIR/exam_end" ] || { echo "No exam in progress (ckad exam)."; return; }
  local left=$(( $(cat "$STATE_DIR/exam_end") - $(date +%s) ))
  if [ "$left" -le 0 ]; then echo "${R}Time is up!${N} Run: ckad check all"
  else printf 'Time left: %dmin %02ds\n' $((left / 60)) $((left % 60)); fi
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  list|ls)   cmd_list ;;
  start)     require_cluster; d=$(resolve "${1:-}"); echo "Setting up the exercise..."; do_setup "$d"; show "$d" ;;
  show)      show "$(resolve "${1:-}")" ;;
  hint)      sed -n '/^## Hints/,$p' "$(resolve "${1:-}")/README.md" ;;
  check)     cmd_check "${1:-}" ;;
  solution)
    d=$(resolve "${1:-}")
    if [ -t 0 ]; then read -r -p "Show the solution? Try 'ckad hint' first. [y/N] " a; [[ "$a" =~ ^[yY]$ ]] || exit 0; fi
    cat "$d/solution.sh" ;;
  reset)
    if [ "${1:-}" = "all" ]; then for id in $(all_ids); do do_reset "$(resolve "$id")"; done; rm -f "$STATE_DIR/exam_end"
    else do_reset "$(resolve "${1:-}")"; fi
    echo "Reset done." ;;
  exam)      cmd_exam "${1:-120}" ;;
  status)    cmd_status ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
